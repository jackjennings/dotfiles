#!/bin/bash

set -e

OP_ACCOUNT="{{ .onepassword.account_id }}"
VAULT="Automation"
# 1Password caps service-account tokens at 2160h (90 days); --expires-in
# rejects anything longer.
EXPIRES_IN_DAYS=90
KEYCHAIN_SERVICE="op-pinentry-service-account"
NAME_FILE=~/.cache/op-service-account-name
EXPIRY_FILE=~/.cache/op-service-account-expiry

mkdir -p ~/.cache

if ! op vault get "$VAULT" --account "$OP_ACCOUNT" &>/dev/null; then
  echo "Creating $VAULT vault..." >&2
  op vault create "$VAULT" --account "$OP_ACCOUNT" \
    --description "Least-privilege secrets for headless/service-account automation" >/dev/null
fi

PREVIOUS_NAME=""
[[ -f "$NAME_FILE" ]] && PREVIOUS_NAME=$(cat "$NAME_FILE")

SERVICE_ACCOUNT_NAME="pinentry-$(date +%Y%m%d)"

echo "Creating service account $SERVICE_ACCOUNT_NAME (read-only, $VAULT vault, expires in ${EXPIRES_IN_DAYS}d)..." >&2

TOKEN=$(op service-account create "$SERVICE_ACCOUNT_NAME" \
    --vault "$VAULT:read_items" \
    --expires-in "${EXPIRES_IN_DAYS}d" \
    --raw \
    --account "$OP_ACCOUNT")

security add-generic-password \
    -a "$(id -un)" \
    -s "$KEYCHAIN_SERVICE" \
    -w "$TOKEN" \
    -U

EXPIRY_DATE=$(date -v+${EXPIRES_IN_DAYS}d +%Y-%m-%d)
echo "$EXPIRY_DATE" > "$EXPIRY_FILE"
echo "$SERVICE_ACCOUNT_NAME" > "$NAME_FILE"

echo "Done. Service account: $SERVICE_ACCOUNT_NAME, expires $EXPIRY_DATE." >&2

if [[ -n "$PREVIOUS_NAME" && "$PREVIOUS_NAME" != "$SERVICE_ACCOUNT_NAME" ]]; then
  echo "Previous service account '$PREVIOUS_NAME' is now superseded." >&2
  echo "op has no CLI delete for service accounts — revoke it manually at" >&2
  echo "https://my.1password.com > Integrations > Service Accounts, once you've confirmed the new one works." >&2
fi
