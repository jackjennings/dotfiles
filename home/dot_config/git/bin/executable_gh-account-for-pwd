#!/usr/bin/env bash

# Resolve by the repo's origin remote first so this also works for lazyboy
# worktrees (~/.lazyboy/worktrees/...), which don't live under ~/code/smarterdx.
# Work repos are cloned via the "github-sdx" SSH host alias or the smarterdx
# GitHub org; see ~/.ssh/config and ~/code/smarterdx/*/.git/config.
remote_url="$(git remote get-url origin 2>/dev/null)"

case "$remote_url" in
    *github-sdx:smarterdx/*|*github.com/smarterdx/*|*github.com:smarterdx/*)
        echo "jack-jennings-sdx"
        exit 0
        ;;
esac

if [[ -z "$remote_url" ]]; then
    case "$PWD" in
        "$HOME/code/smarterdx"|"$HOME/code/smarterdx"/*)
            echo "jack-jennings-sdx"
            exit 0
            ;;
    esac
fi

echo "jackjennings"
