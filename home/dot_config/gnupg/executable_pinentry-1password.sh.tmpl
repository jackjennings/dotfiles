#!/bin/sh

OP_PGP_PASSPHRASE_ITEM="op://Automation/GPG Master Key Passphrase/password"
OP_ACCOUNT="{{ .onepassword.account_id }}"
OP_SERVICE_ACCOUNT_KEYCHAIN_SERVICE="op-pinentry-service-account"
LOG_FILE="${PINENTRY_1P_LOG:-$HOME/.cache/pinentry-1password.log}"
# Max seconds any `op` call may run before we give up. A detached gpg-agent
# has no interactive channel to 1Password, so op can block forever; bounding
# it turns a deadlock into a fast, clean signing error.
OP_TIMEOUT="${OP_TIMEOUT:-15}"

mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE" 2>/dev/null
}

# Locate a timeout command (macOS has none by default; coreutils ships gtimeout).
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT_CMD="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_CMD="gtimeout"
else
  TIMEOUT_CMD=""
  log "no timeout/gtimeout found; op calls are unbounded"
fi

# Run op bounded by a timeout and with stdin detached from the assuan socket.
# Without </dev/null, op would inherit the gpg-agent protocol stream as stdin
# and either corrupt it or block reading from it.
run_op() {
  if [ -n "$TIMEOUT_CMD" ]; then
    "$TIMEOUT_CMD" "$OP_TIMEOUT" op "$@" </dev/null
  else
    op "$@" </dev/null
  fi
}

# Reads OP_SERVICE_ACCOUNT_TOKEN from the login Keychain rather than the
# environment: a detached gpg-agent's pinentry child inherits gpg-agent's
# environment, not whatever shell set the token, so a plain export would not
# reliably reach it regardless of when gpg-agent was started.
service_account_read_passphrase() {
  pinentry_service_account_token=$(security find-generic-password \
    -a "$(id -un)" -s "$OP_SERVICE_ACCOUNT_KEYCHAIN_SERVICE" -w 2>/dev/null)
  [ -n "$pinentry_service_account_token" ] || return 1

  errfile=$(mktemp)
  passphrase=$(OP_SERVICE_ACCOUNT_TOKEN="$pinentry_service_account_token" \
    run_op read "$OP_PGP_PASSPHRASE_ITEM" 2>"$errfile")
  status=$?
  if [ $status -eq 124 ]; then
    log "service-account op read timed out after ${OP_TIMEOUT}s"
  elif [ $status -ne 0 ]; then
    log "service-account op read failed (exit $status): $(cat "$errfile")"
  else
    log "passphrase retrieved via service account"
  fi
  rm -f "$errfile"
  [ $status -eq 0 ] && printf '%s' "$passphrase"
  return $status
}

op_read_passphrase() {
  errfile=$(mktemp)
  passphrase=$(run_op read "$OP_PGP_PASSPHRASE_ITEM" --account "$OP_ACCOUNT" 2>"$errfile")
  status=$?
  if [ $status -eq 124 ]; then
    log "op read timed out after ${OP_TIMEOUT}s (no interactive 1Password session?)"
  elif [ $status -ne 0 ]; then
    log "op read failed (exit $status): $(cat "$errfile")"
  fi
  rm -f "$errfile"
  [ $status -eq 0 ] && printf '%s' "$passphrase"
  return $status
}

read_passphrase() {
  service_account_read_passphrase && return

  op_read_passphrase && return

  log "attempting op signin"
  signin_errfile=$(mktemp)
  run_op signin --account "$OP_ACCOUNT" >/dev/null 2>"$signin_errfile"
  signin_status=$?
  if [ $signin_status -eq 124 ]; then
    log "op signin timed out after ${OP_TIMEOUT}s"
  elif [ $signin_status -ne 0 ]; then
    log "op signin failed (exit $signin_status): $(cat "$signin_errfile")"
  fi
  rm -f "$signin_errfile"

  op_read_passphrase
}

log "pinentry invoked (pid $$)"
echo "OK"
while read cmd rest; do
  case "$cmd" in
    \#*)
      echo "OK"
      ;;
    GETPIN)
      log "GETPIN received"
      passphrase=$(read_passphrase)
      if [ -z "$passphrase" ]; then
        log "no passphrase available"
        echo "ERR 67108949 No passphrase available"
      else
        log "passphrase retrieved"
        echo "D $passphrase"
        echo "OK"
      fi
      ;;
    BYE)
      log "BYE received"
      echo "OK"
      exit 0
      ;;
    *)
      echo "OK"
      ;;
  esac
done
